# Placeholders only. Copy to .env and export (e.g. `set -a; . ./.env; set +a`). NEVER commit real values.
NIGHTSHIFT_DATA_DIR=./data
NIGHTSHIFT_HOST=127.0.0.1
NIGHTSHIFT_PORT=8787
NIGHTSHIFT_MODE=local
# Optional explicit tokens (otherwise `python -m nightshift init` generates 0600 local tokens inside the data dir)
# NIGHTSHIFT_ADMIN_TOKEN=
# NIGHTSHIFT_OPERATOR_TOKEN=
# NIGHTSHIFT_APPROVER_TOKEN=
# NIGHTSHIFT_VIEWER_TOKEN=
# GitHub webhook intake (HMAC-SHA256). Unset = endpoint refuses deliveries.
# NIGHTSHIFT_WEBHOOK_SECRET=
# Optional generic notification webhook (otherwise notifications go to the local outbox only)
# NIGHTSHIFT_NOTIFY_WEBHOOK_URL=
# Live OSV advisory lookups (needs outbound HTTPS). Default off.
NIGHTSHIFT_OSV_ENABLED=0
# Tuning
NIGHTSHIFT_LEASE_SECONDS=60
NIGHTSHIFT_RETRY_MAX_ATTEMPTS=4
NIGHTSHIFT_SEPARATION_OF_DUTIES=1
# Set to 0 ONLY if the host forbids user namespaces; repairs then fail closed instead of running unisolated.
NIGHTSHIFT_SANDBOX_REQUIRE_NETNS=1
