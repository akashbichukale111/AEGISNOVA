# AEGISNOVA Ops - PLACEHOLDERS ONLY. Copy to .env and fill in locally. NEVER commit real values.
# The app reads real process environment variables; it does not auto-load .env (use `set -a; . ./.env; set +a`).

# --- Core (local profile works with none of these) ---
AEGIS_PROFILE=local
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8080
AEGIS_DB_PATH=.local/aegisnova.db
AEGIS_AUTH_MODE=dev
AEGIS_DEV_TOKEN_FILE=.local/dev-tokens.json
AEGIS_WORKER=on
AEGIS_CORS_ORIGINS=
AEGIS_ENABLE_REAL_SEND=false

# --- Governance (UNWIND). Default is the TEST-ONLY local dev provider ---
AEGIS_GOVERNANCE=local
AEGIS_LOCAL_DEV_GOVERNANCE_KEY=
UNWIND_BASE_URL=
UNWIND_API_TOKEN=
UNWIND_ISSUER=
UNWIND_SIGNING_KEY=

# --- AWS (optional; nothing is deployed by this project) ---
AEGIS_AWS_ENABLED=false
AWS_REGION=
AEGIS_STATE_MACHINE_ARN=
AEGIS_WORK_QUEUE_URL=
AEGIS_DLQ_URL=
AEGIS_CW_NAMESPACE=AEGISNOVA/Operations
SNS_EMAIL_TOPIC_ARN=
SNS_SMS_ENABLED=false
AEGIS_RECIPIENT_ALLOWLIST=
# AWS credentials come from the standard AWS credential chain (profile/role), never from this file or the UI.

# --- WhatsApp Business Platform (Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0
WHATSAPP_RECIPIENT_ALLOWLIST=

# --- Tunables (defaults shown in aegisnova_ops/config.py) ---
# AEGIS_MAX_ATTEMPTS=3
# AEGIS_QUEUE_MAX_DEPTH=1000
# AEGIS_ALARM_QUEUEDEPTH_THRESHOLD=500
