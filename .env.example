# ==============================================================================
# AEGISNOVA — Environment Configuration Template
# ==============================================================================
# Notice: Never commit actual API keys, secrets, or credentials.
# All values below are placeholders for local/demo execution.

# Product Environment & Mode
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_NAME="AEGISNOVA"
NEXT_PUBLIC_APP_TAGLINE="A New Standard for Safe AI"
NEXT_PUBLIC_DEMO_MODE=true

# Service Endpoints (Adapters)
# DevGuard AI Scanner/Fixer Backend (FastAPI)
NEXT_PUBLIC_DEVGUARD_API_URL=http://localhost:8000
NEXT_PUBLIC_DEVGUARD_WS_URL=ws://localhost:8000/ws

# UNWIND Governance Core
UNWIND_FIRESTORE_EMULATOR_HOST=localhost:8080
UNWIND_PUBSUB_EMULATOR_HOST=localhost:8085
UNWIND_VERTEX_DISABLED=1
UNWIND_GOVERNANCE_MODE=mock_adapter

# Observability (SigNoz / OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
NEXT_PUBLIC_SIGNOZ_DASHBOARD_URL=http://localhost:8080

# Nebius x NVIDIA AI Hackathon Model Configuration
# ------------------------------------------------------------------------------
# Nebius Token Factory / AI Studio
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# NVIDIA NIM (Inference Microservices)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-4-340b-instruct

# GitHub Delivery (Optional: Leave empty for local patch demo)
GITHUB_TOKEN=your_fine_grained_github_pat_here

# Evidence Research (Optional: Leave empty for local reconciled fixtures)
TAVILY_API_KEY=your_tavily_api_key_here

# Internal Microservices (Local Loopback Ports)
AUTONOMOUS_OPERATIONS_URL=http://127.0.0.1:8080
NIGHTSHIFT_BACKEND_URL=http://127.0.0.1:8787

# Feature Flags (All active in Phase 3)
FEATURE_NIGHTSHIFT_ENABLED=true
FEATURE_EVIDENCE_INTELLIGENCE_ENABLED=true
FEATURE_CAUSAL_IMPACT_ENABLED=true
FEATURE_REPAIR_ASSURANCE_ENABLED=true
FEATURE_AUTONOMOUS_OPERATIONS_ENABLED=true
